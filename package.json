{
  "name": "bedone",
  "version": "0.1.0",
  "private": true,
  "description": "A personal, single-user to-do app built on PocketBase and Svelte.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
