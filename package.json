{
  "name": "bedone",
  "version": "0.1.0",
  "private": true,
  "description": "A personal, single-user to-do app built on PocketBase and Svelte.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:hooks",
    "build:hooks": "vite build --config vite.hooks.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build:hooks && vitest run --config vitest.integration.config.ts",
    "test:all": "npm run check && npm run test && npm run test:integration && npm run test:e2e",
    "pb:setup": "./scripts/setup-pocketbase.sh",
    "pb:serve": "npm run build:hooks && ./pocketbase serve",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "happy-dom": "^20.14.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "pocketbase": "^0.28.1"
  }
}
